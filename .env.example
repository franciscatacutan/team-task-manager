# Clear this value to use an existing PostgreSQL server.
COMPOSE_PROFILES=bundled-postgres

# Database connection
DB_NAME=team_task_manager
DB_USERNAME=team_task_manager
DB_PASSWORD=replace-with-a-local-database-password
DB_URL=jdbc:postgresql://postgres:5432/team_task_manager

# Host port for the included PostgreSQL container
POSTGRES_PORT=5433

# Local Docker app
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=team-task-manager
BOOTSTRAP_ADMIN_EMAIL=sampleadmin@test.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-admin-password
SPRING_PROFILES_ACTIVE=local
FRONTEND_URL=http://localhost:5173
